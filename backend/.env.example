# Copy to .env and adjust for your machine. Values here match docker-compose.yml.

# --- Database (local Postgres from docker-compose) ---
DATABASE_URL=jdbc:postgresql://localhost:5432/jobmatch
DATABASE_USER=jobmatch
DATABASE_PASSWORD=jobmatch

# --- JWT ---
# HS256 requires a secret of at least 32 bytes (256 bits). The app fails fast on a shorter one.
# This is a placeholder for local dev ONLY — generate a real secret for any deployed environment.
JWT_SECRET=local-dev-only-change-me-32byte-minimum-secret

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:5173
