# Base URL of the backend API.
#
# LOCAL DEV: leave this EMPTY (or unset). Requests then go to "/api/..." and are
# proxied to http://localhost:8080 by the Vite dev server (see vite.config.ts).
#
# PRODUCTION (Vercel): set this to your Render backend URL, e.g.
#   VITE_API_BASE_URL=https://jobmatch-backend.onrender.com
# Set it in the Vercel project's Environment Variables, not here.
VITE_API_BASE_URL=
